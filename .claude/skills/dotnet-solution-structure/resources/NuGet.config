<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources — reference configuration.
  Companion to the dotnet-solution-structure skill.

  <clear /> drops sources inherited from machine- and user-level config, so
  the set below is the complete list. Without it a developer's private feed
  can satisfy a restore that fails in CI.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
